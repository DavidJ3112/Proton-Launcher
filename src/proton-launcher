#!/bin/bash

# Proton Launcher - Main Entry Point
# A launcher for running Windows games with Proton
# Supports custom extensions, configurable prefixes, window modes, and more

# Resolve true directory even when executed via symlink (/usr/local/bin)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Load libraries
LIB_DIR="$SCRIPT_DIR/lib"
MODULES_DIR="$SCRIPT_DIR/modules"

# Source all library files
for lib_file in "$LIB_DIR"/*.sh; do
    [ -f "$lib_file" ] && source "$lib_file"
done

# Source all module files
for module_file in "$MODULES_DIR"/*.sh; do
    [ -f "$module_file" ] && source "$module_file"
done

# --------------------------------------------------
# Configuration Setup
# --------------------------------------------------

# Initialize config directory
init_config_dir

# Load configuration
CONFIG_FILE="$CONFIG_DIR/config"
EXTENSIONS_FILE="$CONFIG_DIR/extensions.conf"

if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
fi

# Override with environment variables if set
DB="${DB:-$HOME/.local/share/proton-launcher/games.db}"
LOG_DIR="${LOG_DIR:-$HOME/.local/share/proton-launcher/logs}"
GAME_LOG_DIR="${GAME_LOG_DIR:-$HOME/.local/share/proton-launcher/gamelogs}"
PREFIX_ROOT="${PREFIX_ROOT:-$HOME/Games/ProtonPrefixes}"
PROTON_BASE="${PROTON_BASE:-$HOME/.local/share/Steam/compatibilitytools.d}"
STEAM_PROTON="${STEAM_PROTON:-$HOME/.local/share/Steam/steamapps/common}"

# Ensure user-space log directories exist
mkdir -p "$LOG_DIR" "$GAME_LOG_DIR"

# Hide GStreamer ELFCLASS architecture mismatch warnings
export GST_DEBUG=0
export G_MESSAGES_DEBUG=none

set -u

# --------------------------------------------------
# Logging Setup
# --------------------------------------------------
LOG="${LOG:-$LOG_DIR/proton-launcher.log}"

# Rotate logs (keep max 3)
if [ -f "$LOG.2" ]; then
    rm -f "$LOG.3" 2>/dev/null || true
    mv "$LOG.2" "$LOG.3" 2>/dev/null || true
fi

if [ -f "$LOG.1" ]; then
    mv "$LOG.1" "$LOG.2"
fi

if [ -f "$LOG" ]; then
    mv "$LOG" "$LOG.1"
fi

# Stream output to terminal and main launcher log
exec > >(tee -a "$LOG") 2>&1

echo "=================================="
echo "Proton Launcher - Started: $(date)"
echo "Arguments: $*"
echo "Database: $DB"
echo "=================================="

# --------------------------------------------------
# Database Initialization
# --------------------------------------------------

if ! command -v sqlite3 >/dev/null 2>&1; then
    echo "ERROR: sqlite3 is not installed"
    exit 1
fi

# Initialize database with versioning (auto-migrates to the newest schema)
init_database

# --------------------------------------------------
# CLI Argument & Flag Parsing
# --------------------------------------------------

GAME=""
CONFIGURE=0
FLAG_PROTON=""
FLAG_PREFIX_MODE=""
FLAG_MANGO=""
FLAG_CE=""
CONFIG_MODE=0
FLAG_WINDOW=""

# Extension enabled/disabled state is keyed by extension NAME (e.g.
# "CHEAT_ENGINE"), so this MUST be an associative array. Without this
# declaration bash treats every EXTENSIONS_ENABLED[$name]=... assignment as
# an arithmetic subscript, which silently collapses every extension's state
# onto the same index (0) - this was the root cause of extensions/attached
# launches behaving incorrectly.
declare -A EXTENSIONS_ENABLED

while [[ $# -gt 0 ]]; do
    case "$1" in
        --configure|--config)
            CONFIGURE=1
            shift
            ;;
        --config-mode)
            CONFIG_MODE=1
            shift
            ;;
        --proton)
            FLAG_PROTON="$2"
            shift 2
            ;;
        --prefix)
            FLAG_PREFIX_MODE="$2"
            shift 2
            ;;
        --mango)
            FLAG_MANGO="$2"
            shift 2
            ;;
        --ce)
            FLAG_CE="$2"
            shift 2
            ;;

        --window)
            FLAG_WINDOW="$2"
            shift 2
            ;;
        *)
            GAME="$1"
            shift
            ;;
    esac
done

# Handle config mode
if [ "$CONFIG_MODE" -eq 1 ]; then
    echo "Config mode activated. Editing configuration files..."
    edit_config
    exit 0
fi

# Load extensions from config
AVAILABLE_EXTENSIONS=""
if [ -f "$EXTENSIONS_FILE" ]; then
    while IFS='=' read -r ext_name ext_path; do
        # Skip comments and empty lines
        [[ "$ext_name" =~ ^[[:space:]]*# ]] && continue
        [[ -z "$ext_name" ]] && continue
        
        # Clean up the name
        ext_name=$(echo "$ext_name" | xargs)

        # Skip optional "<NAME>_MOUNTS" companion entries - those aren't
        # extensions themselves, just extra mount config for one.
        [[ "$ext_name" == *_MOUNTS ]] && continue
        
        if [ -n "$ext_name" ]; then
            AVAILABLE_EXTENSIONS="$AVAILABLE_EXTENSIONS $ext_name"
            # Initialize extension as disabled by default
            EXTENSIONS_ENABLED[$ext_name]=0
        fi
    done < "$EXTENSIONS_FILE"
fi

# Set CHEAT_ENGINE if not already set
if [ -z "${CHEAT_ENGINE:-}" ]; then
    CHEAT_ENGINE="$HOME/Cheat Engine/Cheat Engine.exe"
fi

# Get the actual Cheat Engine executable path (handles 32/64-bit variants)
TARGET_CE="$(get_cheat_engine_exe)"
if [ -n "$TARGET_CE" ] && [ -f "$TARGET_CE" ]; then
    CHEAT_ENGINE="$(realpath "$TARGET_CE")"

    # Register Cheat Engine as a regular extension (only if it's actually
    # installed, and only if it's not already listed in extensions.conf).
    case " $AVAILABLE_EXTENSIONS " in
        *" CHEAT_ENGINE "*) ;;
        *)
            AVAILABLE_EXTENSIONS="$AVAILABLE_EXTENSIONS CHEAT_ENGINE"
            EXTENSIONS_ENABLED[CHEAT_ENGINE]=0
            ;;
    esac
else
    echo "WARNING: Cheat Engine not found at ${TARGET_CE:-not configured}"
    CHEAT_ENGINE=""
fi

cleanup_stale_running

# --------------------------------------------------
# Game Selection
# --------------------------------------------------

if [ -z "$GAME" ]; then
    select_game
fi

if [ ! -f "$GAME" ]; then
    echo "ERROR: Executable file not found: $GAME"
    display_error "Executable file not found:\n$GAME"
    exit 1
fi

GAME="$(realpath "$GAME")"

# --------------------------------------------------
# Extension Attach / Standalone Launch
#
# If the requested executable is itself a configured extension (Cheat
# Engine, an overlay tool, etc.) run the F1-F5 attach pipeline instead of
# treating it like a normal game. handle_extension_launch exits the process
# itself in every case where it actually handles the launch; it only
# returns (with status 1) when $GAME isn't a recognized extension, in which
# case we fall through to normal game execution below.
# --------------------------------------------------

handle_extension_launch "$GAME"

# --------------------------------------------------
# Normal Game Execution Setup
# --------------------------------------------------

GAME_DIR="$(dirname "$GAME")"
GAME_BASENAME="$(basename "$GAME")"
AUTO_NAME="${GAME_BASENAME%.*}"
DIR_NAME="$(basename "$GAME_DIR")"
GAME_NAME_DISPLAY="[$DIR_NAME] $GAME_BASENAME"

MARKER_ID="$(get_marker_id "$GAME_DIR")"

# 32-Bit Check
IS_32BIT=0
if check_32bit "$GAME"; then
    IS_32BIT=1
fi

discover_protons

HAVE_SAVED=0
if load_game_config "$MARKER_ID"; then
    HAVE_SAVED=1
    
    # Load saved extensions for this game
    extensions_rows=$(get_game_extensions "$MARKER_ID")
    while IFS='|' read -r ext_name ext_enabled; do
        [ -z "$ext_name" ] && continue
        EXTENSIONS_ENABLED[$ext_name]="$ext_enabled"
    done <<< "$extensions_rows"
else
    PREFIX_MODE="auto"
    MANUAL_NAME=""
    SEL_PROTON_NAME=""
    SEL_PROTON_PATH=""
    CE_AUTOBOOT=0
    MANGOHUD=1
    WINDOW_WIDTH=""
    WINDOW_HEIGHT=""
    WINDOW_MODE="default"
fi

# Apply Flag Overrides
[ -n "$FLAG_PROTON" ] && SEL_PROTON_NAME="$FLAG_PROTON"
[ -n "$FLAG_PREFIX_MODE" ] && PREFIX_MODE="$FLAG_PREFIX_MODE"
[ -n "$FLAG_MANGO" ] && MANGOHUD="$FLAG_MANGO"
[ -n "$FLAG_CE" ] && CE_AUTOBOOT="$FLAG_CE"


# Parse window flag (format: WxH or mode:WxH)
if [ -n "$FLAG_WINDOW" ]; then
    if [[ "$FLAG_WINDOW" =~ ^([a-z]+):([0-9]+)x([0-9]+)$ ]]; then
        WINDOW_MODE="${BASH_REMATCH[1]}"
        WINDOW_WIDTH="${BASH_REMATCH[2]}"
        WINDOW_HEIGHT="${BASH_REMATCH[3]}"
    elif [[ "$FLAG_WINDOW" =~ ^([a-z]+)$ ]]; then
        WINDOW_MODE="${BASH_REMATCH[1]}"
    fi
fi

# Resolve Proton path
if [ -n "$SEL_PROTON_NAME" ]; then
    SEL_PROTON_PATH="$(sqlite3 "$DB" "SELECT path FROM protons WHERE name = '$(sql_escape "$SEL_PROTON_NAME")' LIMIT 1;")"
fi

# Check if we need to show configuration menu
if [ "$HAVE_SAVED" = "1" ] && [ -n "$SEL_PROTON_NAME" ]; then
    PROTON_STATUS="$(sqlite3 "$DB" "SELECT status FROM protons WHERE name = '$(sql_escape "$SEL_PROTON_NAME")';")"
    [ "$PROTON_STATUS" != "active" ] && CONFIGURE=1
fi

[ "$HAVE_SAVED" = "0" ] && [ -z "$FLAG_PROTON" ] && CONFIGURE=1

if [ "$CONFIGURE" = "1" ]; then
    show_launch_or_settings
fi

# --------------------------------------------------
# Final Launch
# --------------------------------------------------

case "$PREFIX_MODE" in
    auto)      PREFIX_NAME="$AUTO_NAME" ;;
    directory) PREFIX_NAME="$DIR_NAME" ;;
    manual)    PREFIX_NAME="${MANUAL_NAME:-$AUTO_NAME}" ;;
    *)         PREFIX_NAME="$AUTO_NAME" ;;
esac

launch_game "$GAME" "$MARKER_ID"
